# Copy this file to .env.local and fill in your real key.
# Everything except the "Explain in detail" AI panel works without it.

# Get a free key at https://console.groq.com/keys (server-side only; never prefix with NEXT_PUBLIC_)
GROQ_API_KEY=

# Optional
# GROQ_MODEL=openai/gpt-oss-120b
# Per-visitor and whole-site AI requests allowed per minute
# EXPLAIN_RATE_PER_MIN=12
# EXPLAIN_GLOBAL_PER_MIN=120
# Number of reverse proxies in front of the app (Vercel/nginx = 1). 0 = ignore X-Forwarded-For.
# TRUSTED_PROXY_HOPS=1
